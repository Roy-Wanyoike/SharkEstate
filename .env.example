# Database / PostgreSQL
DATABASE_URL=postgresql://shark:CHANGE_ME@localhost:5432/sharkestate?sslmode=disable
POSTGRES_USER=shark
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sharkestate

# Identity / OIDC (Keycloak candidate — ADR pending in #3)
OIDC_ISSUER_URL=https://keycloak.example.com/realms/sharkestate
OIDC_CLIENT_ID=sharkestate-web
OIDC_CLIENT_SECRET=CHANGE_ME

# Object storage (private, scoped access)
S3_ENDPOINT=
S3_BUCKET=sharkestate-private
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_REGION=us-east-1

# Runtime
APP_ENV=development
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=

# Background jobs
JOB_QUEUE_URL=
